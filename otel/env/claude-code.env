# Claude Code → OTLP collector.
#
# Source this for one shell. To make it durable, run `just settings` — it renders
# this file as the `env` block of ~/.claude/settings.json, ready to paste. Do not
# hand-convert: this is shell syntax and that file is JSON.
#
# This file is the source of truth. `just settings` reads it and carries no copy.
#
# Verified against the v2.1.220 binary and code.claude.com/docs/en/monitoring-usage
# on 2026-09-12.

CLAUDE_CODE_ENABLE_TELEMETRY=1

OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp

# THERE IS NO DEFAULT PROTOCOL. Omit this and Claude Code throws:
#   "Unknown protocol set in OTEL_EXPORTER_OTLP_LOGS_PROTOCOL or
#    OTEL_EXPORTER_OTLP_PROTOCOL env var: undefined"
# Most likely cause of "I enabled telemetry and nothing arrived".
# https://code.claude.com/docs/en/monitoring-usage
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Base endpoint, no signal path — the exporter appends /v1/metrics etc.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Defaults to `delta`. Prometheus and Mimir want cumulative; leave it on delta
# and your counters will look wrong rather than absent, which is worse.
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=cumulative

# Defaults to 60000. A correct setup prints nothing for a full minute at the
# default and reads as broken.
OTEL_METRIC_EXPORT_INTERVAL=10000

# --- cardinality -------------------------------------------------------------
# session.id is a fresh UUID per session and defaults ON, so it mints a new time
# series per session per metric. Turn it off for metrics; it stays available on
# events and spans, which is where you actually correlate a turn.
OTEL_METRICS_INCLUDE_SESSION_ID=false
OTEL_METRICS_INCLUDE_ACCOUNT_UUID=false
# Custom OTEL_RESOURCE_ATTRIBUTES land as labels on EVERY datapoint by default.
# If you tag by repo or branch, this is the difference between a label and an
# outage.
OTEL_METRICS_INCLUDE_RESOURCE_ATTRIBUTES=false
# Cheap, bounded, and you want it: three known caveats are version-bound.
OTEL_METRICS_INCLUDE_VERSION=true

# --- content: all default OFF. See README trap 5 before changing any. ---
#
# OTEL_LOG_USER_PROMPTS=1 exports prompt text.
#
# If you set that, ALSO set the line below explicitly. When unset,
# OTEL_LOG_ASSISTANT_RESPONSES *falls back to* OTEL_LOG_USER_PROMPTS — so
# deployments that already logged prompts silently began exporting model output
# on upgrade to 2.1.193, with no config change.
OTEL_LOG_ASSISTANT_RESPONSES=0

# OTEL_LOG_RAW_API_BODIES=1 exports the ENTIRE conversation history, the system
# prompt and every tool definition. Anthropic's own words: enabling it "implies
# consent to everything OTEL_LOG_USER_PROMPTS, OTEL_LOG_TOOL_DETAILS, and
# OTEL_LOG_TOOL_CONTENT would reveal". Debug only. Never in a default profile.

# --- traces: beta, off by default --------------------------------------------
# Works on 2.1.220. Gated only by the env var below — no org allowlist, no
# server-side flag. Verified in the binary and reproducible with `just smoke`.
# CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1
# OTEL_TRACES_EXPORTER=otlp
